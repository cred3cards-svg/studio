/**
 * @file Overview
 * This ruleset enforces a simple security model where authenticated users can create purchase records,
 * while access to sale statistics and configuration is restricted to administrators.  There is no concept of
 * user ownership or shared access, so a simpler pattern of read/write access based on authentication
 * status and/or administrative roles is used. All data resides in top-level collections.
 *
 * Data Structure:
 * - /purchases/{purchaseId}: Stores individual purchase records.
 * - /sale_stats/{statsId}: Stores aggregated statistics for the token sale.
 * - /config/{configId}: Stores configuration values for the application.
 *
 * Key Security Decisions:
 * - Only authenticated users can create purchase records.  No update or delete is allowed.
 * - Access to sale statistics and configuration is restricted to administrators (no admin role is currently enforced in this prototype ruleset).
 * - No user listing is allowed.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows authenticated users to create purchase records. No updates or deletes are allowed.
     * @path /purchases/{purchaseId}
     * @allow (create) request.auth != null
     * @deny (create) request.auth == null
     * @deny (update) Always
     * @deny (delete) Always
     * @principle Authenticated users can create purchase records.
     */
    match /purchases/{purchaseId} {
      allow get: if false;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to sale statistics to administrators. No admin role is currently enforced in this prototype ruleset.
     * @path /sale_stats/{statsId}
     * @allow (get, list) Always
     * @deny (create, update, delete) Always
     * @principle Only admins can create, update, or delete sale statistics.
     */
    match /sale_stats/{statsId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Restricts access to configuration to administrators. No admin role is currently enforced in this prototype ruleset.
     * @path /config/{configId}
     * @allow (get, list) Always
     * @deny (create, update, delete) Always
     * @principle Only admins can create, update, or delete configuration.
     */
    match /config/{configId} {
      allow get: if true;
      allow list: if true;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    // Helper function to check if a user is signed in.
    function isSignedIn() {
      return request.auth != null;
    }
  }
}